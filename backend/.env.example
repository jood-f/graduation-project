# Backend environment variables
#
# Local development:
# - DATABASE_URL should point at your Postgres database.
# - If your network/runtime cannot reach Supabase's direct IPv6 Postgres host,
#   use the Supabase pooler/connection-pool URL instead.
# - SUPABASE_KEY should be a backend-capable key for storage operations.
#
# Azure Container Apps:
# - Prefer setting secrets in Azure and binding them as env vars.

DATABASE_URL=postgresql+psycopg://username:password@host:5432/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-storage-capable-key
SUPABASE_BUCKET=mission_images
DEFAULT_TELEMETRY_PANEL_ID=
AUTO_TELEMETRY_ANALYSIS_ENABLED=true
AUTO_TELEMETRY_ANALYSIS_THRESHOLD=5.0
AUTO_TELEMETRY_ANALYSIS_HOURS=24
AUTO_TELEMETRY_ANALYSIS_MODE=inline
AUTO_TELEMETRY_ANALYSIS_LOOKBACK_ROWS=128
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://your-netlify-site.netlify.app
CV_MODEL_PATH=/app/CV/best.pt
ML_MODEL_PATH=/app/ml/telemetry_power_model.h5
ML_SCALER_X_PATH=/app/ml/telemetry_scaler_X.joblib
ML_SCALER_Y_PATH=/app/ml/telemetry_scaler_y.joblib
CV_ALLOW_HEURISTIC_FALLBACK=false
