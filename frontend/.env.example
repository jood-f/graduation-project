# Frontend environment variables
#
# Local development:
# - Point VITE_API_BASE_URL at your local FastAPI server origin.
# - Vite will add /api/v1 automatically if you omit it.
#
# Netlify production:
# - Set VITE_API_BASE_URL in the Netlify UI to your Azure backend URL.
# - Do not point production builds at localhost.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_TIMEOUT_MS=30000
# Optional:
# VITE_GEMINI_API_KEY=
# VITE_MOCK_AI=false
